#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>   /* &mkp, &msc, LCLK/RCLK/MCLK, SCRL_* */

/* Layer indices. Defined BEFORE mouse.dtsi so it can reference MOUSE. */
#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define MOUSE   3

/* Pointer hardware + split plumbing (see the file for the wiring TODOs). */
#include "mouse.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Stock `corne` is a 3x6+3 (42-key) matrix. If your Corne v2 has the
         * outer column physically detached, those outer keys simply never fire,
         * so leaving real bindings there is harmless. Port your own layers in.
         */

        default_layer {
            display-name = "Base";
            bindings = <
   &kp TAB    &kp Q  &kp W  &kp E     &kp R      &kp T        &kp Y    &kp U      &kp I      &kp O    &kp P     &kp BSPC
   &kp LCTRL  &kp A  &kp S  &kp D     &kp F      &kp G        &kp H    &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
   &kp LSHFT  &kp Z  &kp X  &kp C     &kp V      &kp B        &kp N    &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                            &mo MOUSE &mo LOWER  &kp SPACE    &kp RET  &mo RAISE  &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
   &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &kp N6    &kp N7    &kp N8    &kp N9     &kp N0    &kp BSPC
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans    &trans
   &kp LSHFT  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &trans    &trans     &trans    &trans
                              &trans  &trans  &trans      &trans    &trans    &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
   &kp TAB    &kp EXCL   &kp AT     &kp HASH  &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR  &kp BSPC
   &kp LCTRL  &kp MINUS  &kp EQUAL  &kp GRAVE &kp LBRC   &kp RBRC     &kp LBKT   &kp RBKT   &kp BSLH   &kp PIPE  &kp TILDE &kp SQT
   &kp LSHFT  &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans   &trans   &trans     &trans     &trans    &trans    &trans
                               &trans  &trans  &trans      &trans    &trans    &kp RALT
            >;
        };

        /*
         * MOUSE layer (held via the left-inner thumb `&mo MOUSE`).
         * Left hand keeps mods live (Ctrl/Shift/Alt) so Ctrl-click etc. work.
         * Right hand becomes mouse buttons + scroll, per the Scoot model.
         */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
   &trans     &trans  &trans  &trans  &trans  &trans      &msc SCRL_UP   &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans      &msc SCRL_DOWN &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
   &kp LSHFT  &trans  &trans  &trans  &trans  &trans      &trans         &trans     &trans     &trans     &trans  &trans
                              &trans  &trans  &kp LALT     &mkp LCLK      &trans     &trans
            >;
        };
    };
};
