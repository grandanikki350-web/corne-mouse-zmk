#include <behaviors.dtsi>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Desk-mouse hardware (PMW3360 on the right half) + the split plumbing that
 * carries its motion to the left/central half. See config/mouse.dtsi for the
 * wiring TODOs. This is the only addition on top of the base corne-zmk keymap.
 *
 * Layer indices used below (unchanged from corne-zmk):
 *   0 = main   1 = upper (hold left thumb SPACE)   2 = lower   3 = extra
 * The `upper` layer already carries &mkp MB1/MB2, so it's the natural
 * hold-to-mouse gate -- see the `layers` note in mouse.dtsi.
 */

#include "mouse.dtsi"

&lt { tapping-term-ms = <150>; };

&mt { tapping-term-ms = <150>; };

/ {
    behaviors {
        // Shift no X (mao esquerda): so segura se a proxima tecla for da mao DIREITA

        lsft: left_shift_positional {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        // Shift no . (mao direita): so segura se a proxima tecla for da mao ESQUERDA

        rsft: right_shift_positional {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        main {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&mmv MOVE_Y(200)  &kp Q               &kp W  &kp E                 &kp R  &kp T    &kp Y            &kp U                        &kp I      &kp O    &kp P         &to 2
&mmv MOVE_Y(600)  &kp A               &kp S  &kp D                 &kp F  &kp G    &kp H            &kp J                        &kp K      &kp L    &kp SEMI      &kp SINGLE_QUOTE
&mmv MOVE_Y(600)  &lsft LEFT_SHIFT Z  &kp X  &kp C                 &kp V  &kp B    &kp N            &kp M                        &kp COMMA  &kp DOT  &kp QUESTION  &kp RG(SPACE)
                                             &mt (LEFT_GUI) LG(Q)  &to 4  &to 3    &mt ENTER SPACE  &mt RG(BACKSPACE) BACKSPACE  &to 1
            >;
        };

        upper {
            bindings = <
&trans  &kp ASTERISK  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp PLUS            &kp LS(BACKSLASH)      &kp RIGHT_PARENTHESIS  &kp BACKSLASH      &kp LS(LEFT_BRACKET)  &kp LEFT_BRACKET  &trans
&trans  &kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &mt COMMA PERIOD    &kp LS(RIGHT_BRACKET)  &kp LEFT_PARENTHESIS   &kp RIGHT_BRACKET  &kp LS(APOSTROPHE)    &kp APOSTROPHE    &trans
&trans  &kp RA(Q)     &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp MINUS           &mkp MB1               &mkp MB2               &kp CAPSLOCK       &kp GRAVE             &kp LS(GRAVE)     &trans
                                    &kp BACKSPACE  &trans        &kp ENTER           &trans                 &mo 3                  &to 0
            >;
        };

        lower {
            bindings = <
&trans            &kp RA(Q)             &kp RA(W)        &kp PLUS   &kp ASTERISK      &kp LS(NON_US_BSLH)    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp PAGE_DOWN        &kp PAGE_UP   &kp END          &none          &trans
&kp LEFT_BRACKET  &kp NON_US_BACKSLASH  &kp UNDERSCORE   &kp MINUS  &kp EQUAL         &kp AMPERSAND          &kp LEFT_ARROW                     &kp DOWN_ARROW       &kp UP_ARROW  &kp RIGHT_ARROW  &kp BACKSPACE  &ext_power EP_OFF
&kp COLON         &kp AT_SIGN           &kp EXCLAMATION  &kp HASH   &kp DOLLAR        &kp PERCENT            &mmv MOVE_X(500)                   &mmv (MOVE_X(-500))  &mkp MB1      &mkp MB2         &none          &ext_power EP_ON
                                                         &trans     &ext_power EP_ON  &ext_power EP_OFF      &mmv MOVE_Y(500)                   &mmv (MOVE_Y(-500))  &to 0
            >;
        };

        extra {
            bindings = <
&kp C_AC_UNDO  &kp C_AC_REDO  &kp C_AC_PASTE  &kp UP_ARROW  &kp C_AC_COPY      &kp PG_UP           &kp C_AC_REFRESH  &msc MOVE_Y(15)     &msc (MOVE_Y(-15))   &msc MOVE_X(15)      &msc (MOVE_X(-15))  &trans
&kp C_AC_CUT   &kp INSERT     &kp LEFT_ARROW  &kp DOWN      &kp RIGHT          &kp PAGE_DOWN       &mmv MOVE_X(600)  &mmv MOVE_Y(600)    &mmv (MOVE_Y(-600))  &mmv (MOVE_X(-600))  &mkp MB3            &mkp MB4
&kp LS(LG(N))  &kp LS(LG(Z))  &kp LG(Z)       &kp LG(N)     &kp LG(W)          &kp LG(T)           &mkp MB5          &kp C_AC_FAVORITES  &kp RG(T)            &kp RG(W)            &trans              &trans
                                              &trans        &kp C_AC_ZOOM_OUT  &kp C_AC_ZOOM_IN    &mkp MB1          &mkp MB2            &to 0
            >;
        };

        layer_4 {
            bindings = <
&kp C_AC_FORWARD_MAIL  &kp C_AC_REPLY  &kp C_AL_MAIL        &kp C_AL_SELECT_TASK  &kp C_AL_PREVIOUS_TASK  &kp C_AL_NEXT_TASK     &kp C_AC_SCROLL_UP  &kp C_AC_SCROLL_DOWN  &kp C_AC_OPEN         &kp C_AC_NEW            &kp C_AC_SAVE         &kp C_AC_PRINT
&kp C_AC_SEND          &kp C_AC_EXIT   &mmv (MOVE_X(-300))  &mmv MOVE_X(300)      &mmv MOVE_Y(300)        &mmv (MOVE_Y(-300))    &kp C_MUTE          &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_SLEEP_MODE        &kp C_AL_SCREENSAVER  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS
&kp C_AC_CANCEL        &kp ESC         &msc (MOVE_X(-15))   &msc MOVE_X(15)       &msc (MOVE_Y(-15))      &msc MOVE_Y(15)        &kp C_SHUFFLE       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_AL_CONTROL_PANEL  &kp C_PIP             &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS
                                                            &kp C_RW              &kp C_FAST_FORWARD      &kp C_PLAY_PAUSE       &kp C_AC_GOTO       &kp C_AL_LOGOFF       &to 0
            >;
        };
    };
};
